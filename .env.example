# Telegram bot token from @BotFather (https://t.me/BotFather -> /newbot). Required.
BOT_TOKEN=

# Your Telegram chat ID. Pins the owner so it survives redeploys on hosts with an ephemeral disk.
# Leave empty to let the first person who sends /start claim the bot.
OWNER_CHAT_ID=

# How often to poll the booking API, in seconds. Values below 30 are raised to 30.
POLL_INTERVAL_SEC=60

# Directory for state.json. Empty = project root. On ephemeral hosts (Railway, Fly, ...)
# point it at a mounted volume (e.g. /data) so the owner and /setbranch changes survive redeploys.
STATE_DIR=

# --- Qmatic target. The defaults are the Gdańsk PUW citizenship ("obywatelstwo") service. ---
PUW_BASE=https://rezerwacja.gdansk.uw.gov.pl:8445/qmaticwebbooking
BRANCH_ID=1cf1e3e60eeb96dae2bb572487249bd48cc5bed0024960eaee0c893ce4918569
SERVICE_ID=2c5251d564aaf0b09c2a39d69cf7ed4cb1e142ab3a501b4b688e1e7c2d80b8e0
CUSTOM_SLOT_LENGTH=40
